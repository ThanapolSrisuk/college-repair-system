{
  "info": {
    "name": "Repair API",
    "description": "Postman Collection สำหรับทดสอบระบบแจ้งซ่อม /api/v1/repair-requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Repair Request (Success - 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Default status is pending\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"pending\");",
              "    pm.expect(jsonData.computerId).to.eql(105);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"computerId\": 105,\n  \"symptom\": \"คีย์บอร์ดกดไม่ติดบางปุ่ม\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests"]
        }
      }
    },
    {
      "name": "2. Create Repair Request (Validation Error - 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Response contains error message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"computerId\": 105,\n  \"symptom\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests"]
        }
      }
    },
    {
      "name": "3. Get All Repair Requests (Success - 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests"]
        }
      }
    },
    {
      "name": "4. Get Repair Requests Filtered by Status (Success - 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests?status=pending",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests"],
          "query": [
            {
              "key": "status",
              "value": "pending"
            }
          ]
        }
      }
    },
    {
      "name": "5. Get Repair Request By ID (Success - 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns correct ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests", "1"]
        }
      }
    },
    {
      "name": "6. Get Repair Request By ID (Not Found - 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Message is Request not found\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"Request not found\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests/999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests", "999"]
        }
      }
    },
    {
      "name": "7. Update Repair Request Status (Success - 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Status updated to done\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"done\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"done\",\n  \"technicianId\": 501,\n  \"resultNote\": \"เปลี่ยนสายสัญญาณและทดสอบเรียบร้อย\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests/2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests", "2"]
        }
      }
    },
    {
      "name": "8. Delete Repair Request (Conflict - 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 Conflict when already accepted\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests/2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests", "2"]
        }
      }
    },
    {
      "name": "9. Delete Repair Request (Success - 204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/repair-requests/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "repair-requests", "1"]
        }
      }
    }
  ]
}